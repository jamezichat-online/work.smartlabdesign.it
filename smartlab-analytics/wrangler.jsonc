{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartlab-analytics",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/catalog.json"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "smartlab-analytics-db" }],
  "observability": { "enabled": false }
}
