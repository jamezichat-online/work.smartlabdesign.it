{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartlab-analytics",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/catalog.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartlab-analytics-db",
      "database_id": "217e137b-a2a4-4a31-9118-402e3f532be3"
    }
  ],
  "observability": {
    "enabled": false
  }
}
